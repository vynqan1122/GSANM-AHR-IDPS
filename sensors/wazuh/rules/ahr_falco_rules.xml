<group name="ahr,web_baseline,">
  <rule id="100200" level="3">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">^90001(?:0[1-9]|[12][0-9]|3[0-2])$</field>
    <description>AHR maintained HTTP signature: $(alert.signature)</description>
  </rule>
  <rule id="100201" level="8">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id" type="pcre2">^900010[1-7]$</field>
    <description>AHR SQL injection indicators: $(alert.signature)</description>
    <group>ahr_web_detection,</group>
  </rule>
  <rule id="100202" level="8">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id" type="pcre2">^90001(?:0[89]|1[0-3])$</field>
    <description>AHR Cross-site scripting indicators: $(alert.signature)</description>
    <group>ahr_web_detection,</group>
  </rule>
  <rule id="100203" level="10">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id" type="pcre2">^(?:900011[4-7]|9000130)$</field>
    <description>AHR Local or remote file inclusion indicators: $(alert.signature)</description>
    <group>ahr_web_detection,</group>
  </rule>
  <rule id="100204" level="10">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id" type="pcre2">^90001(?:1[89]|2[01])$</field>
    <description>AHR Command injection indicators: $(alert.signature)</description>
    <group>ahr_web_detection,</group>
  </rule>
  <rule id="100205" level="5">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id" type="pcre2">^900012[2-6]$</field>
    <description>AHR Sensitive file reconnaissance: $(alert.signature)</description>
    <group>ahr_web_detection,</group>
  </rule>
  <rule id="100206" level="10">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id" type="pcre2">^900012[78]$</field>
    <description>AHR Server-side upload indicators: $(alert.signature)</description>
    <group>ahr_web_detection,</group>
  </rule>
  <rule id="100207" level="10">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id" type="pcre2">^9000129$</field>
    <description>AHR Metadata URL in file inclusion: $(alert.signature)</description>
    <group>ahr_web_detection,</group>
  </rule>
  <rule id="100208" level="5">
    <if_sid>100200</if_sid>
    <field name="alert.signature_id" type="pcre2">^900013[12]$</field>
    <description>AHR HTTP tool or method indicators: $(alert.signature)</description>
    <group>ahr_web_detection,</group>
  </rule>
  <rule id="100250" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100201</if_matched_sid>
    <same_field>src_ip</same_field>
    <same_field>dest_ip</same_field>
    <description>AHR Repeated SQL injection indicators from $(src_ip) to $(dest_ip); validate original client before response.</description>
    <group>ahr_web_correlation,</group>
  </rule>
  <rule id="100251" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100205</if_matched_sid>
    <same_field>src_ip</same_field>
    <same_field>dest_ip</same_field>
    <description>AHR Repeated sensitive file probes from $(src_ip) to $(dest_ip); validate original client before response.</description>
    <group>ahr_web_correlation,</group>
  </rule>
  <rule id="100252" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100202</if_matched_sid>
    <same_field>src_ip</same_field>
    <same_field>dest_ip</same_field>
    <description>AHR Repeated XSS indicators from $(src_ip) to $(dest_ip); validate original client before response.</description>
    <group>ahr_web_correlation,</group>
  </rule>
</group>
