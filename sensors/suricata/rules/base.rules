# Local deterministic rules for AHR-IDPS Phase 2.
# SID range 9000000-9000999 is reserved for hand-maintained lab rules.

# This alert is deliberately narrow and harmless. The acceptance script sends
# a real HTTP request through loopback-bound Nginx with a unique path suffix,
# then proves that Suricata parsed the packet and matched this signature.
alert http any any -> any any (msg:"AHR-IDPS Phase 2 real traffic acceptance probe"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/ahr-suricata-acceptance/"; startswith; metadata:created_at 2026_08_12, deployment Perimeter, signature_severity Informational; sid:9000001; rev:1;)

