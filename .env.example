# AHR-IDPS Phase 1 lab configuration.
# scripts/start_lab.sh copies this file to .env and replaces every CHANGE_ME
# secret with a random 48-character hexadecimal value.

COMPOSE_PROJECT_NAME=ahr-idps
TZ=UTC
LAB_HTTP_PORT=8080

# Exact registry digests verified by the Phase 1 acceptance run. The version
# comments keep upgrade intent visible while preventing tag drift.
NGINX_IMAGE=nginx@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236 # 1.28.3-alpine3.23
DVWA_IMAGE=ghcr.io/digininja/dvwa@sha256:f332a2356b819df77fde5c5453b658ce222c82f909bdd35bc711019e0e89392c # upstream latest resolved 2026-08-12
MARIADB_IMAGE=mariadb@sha256:67873d30a17f6a9c331f06363b2fa15f38abca415529966d67c84f87f82439fe # 11.4.12
POSTGRES_IMAGE=postgres@sha256:42b8b8b29c8a4e933d88943e5b03001a78794905cf786e6e7634e9f2abd5a0d3 # 16.14-alpine3.23
REDIS_IMAGE=redis@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2 # 7.4.10-alpine3.21

DVWA_DB_NAME=dvwa
DVWA_DB_USER=dvwa
DVWA_DB_PASSWORD=CHANGE_ME_DVWA_DB_PASSWORD
MARIADB_ROOT_PASSWORD=CHANGE_ME_MARIADB_ROOT_PASSWORD
DVWA_SECURITY_LEVEL=low
DVWA_LOCALE=en

POSTGRES_DB=ahr_idps
POSTGRES_SUPERUSER=ahr_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_POSTGRES_SUPERUSER_PASSWORD
AHR_DB_USER=ahr_app
AHR_DB_PASSWORD=CHANGE_ME_AHR_DB_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
AHR_ALLOW_LEGACY_LAB_SECRETS=false
